<section class="section drywatch" id="dry" aria-labelledby="dry-title">
  <svg class="dw-cracks" viewBox="0 0 800 400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 210 120 190l60 40 90-30 40 60 110-40 70 30 100-50 80 40 130-20M180 230l-20 90M310 260l30 120M420 220l-10-120M590 200l40-110M520 250l-60 150" />
  </svg>
  <div class="wrap">
    <div class="section-head">
      <span class="kicker" data-reveal><span class="geez">፫</span>Dry watch</span>
      <h2 class="headline" id="dry-title" data-reveal style="--d:.08s">Where the rain <span class="ember-text">is not</span> happening.</h2>
      <p class="lede" data-reveal style="--d:.16s">Every region compared with its own normal for this time of year. Bars to the left of the line are running short of rain; bars to the right are wetter than usual. Regions in their normal dry season are set aside, because no rain there is expected, not a failure.</p>
    </div>

    <div class="dw-grid">
      <div class="card dw-chart" data-reveal>
        <div class="dw-head">
          <h3 class="card-title">Rain over the last 60 days, % of normal</h3>
          <div class="dw-window" role="radiogroup" aria-label="Time window">
            <button class="chip" aria-pressed="false" data-win="d30">30 days</button>
            <button class="chip" aria-pressed="true" data-win="d60">60 days</button>
            <button class="chip" aria-pressed="false" data-win="d90">90 days</button>
          </div>
        </div>
        <div class="dw-axis" aria-hidden="true"><span>0%</span><span>normal · 100%</span><span>200%+</span></div>
        <div class="dw-rows" data-rows role="list">
          {Array.from({ length: 8 }).map(() => <div class="skeleton" style="height:46px;margin:6px 0"></div>)}
        </div>
        <details class="table-toggle"><summary>Show as a table</summary><div class="table-scroll" data-table></div></details>
      </div>

      <div class="dw-side">
        <div class="card dw-rest" data-reveal style="--d:.1s">
          <span class="label"><svg class="zi"><use href="#i-moon" /></svg> Resting season</span>
          <h3 class="card-title">Dry by design</h3>
          <p class="card-sub">Rain is not expected here right now. These regions are waiting for their next rainy season.</p>
          <div class="rest-list" data-rest></div>
        </div>
        <div class="card dw-explain" data-reveal style="--d:.2s">
          <span class="label"><svg class="zi"><use href="#i-info" /></svg> How we measure</span>
          <p><b>Normal</b> is the long-term average rain for the same days of the year at the same place, from NASA POWER (1981 onwards).</p>
          <p><b>Below 75%</b> of normal during a rainy season is a deficit; below 50% is severe. A <b>dry spell</b> counts consecutive days with less than 1 mm.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .drywatch { background: linear-gradient(180deg, transparent, #2a120c33 30%, #2a120c55 70%, transparent); overflow: hidden; }
  .dw-cracks { position: absolute; inset: 10% 0 auto; width: 100%; height: 70%; pointer-events: none; z-index: 0; }
  .dw-cracks path { fill: none; stroke: #ff5b2e18; stroke-width: 2; stroke-dasharray: 1400; stroke-dashoffset: 1400; transition: stroke-dashoffset 3s var(--ease-out); }
  .drywatch.cracked .dw-cracks path { stroke-dashoffset: 0; }
  .dw-grid { position: relative; display: grid; grid-template-columns: 1.7fr 1fr; gap: 18px; align-items: start; }
  .dw-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .dw-window { display: flex; gap: 6px; }
  .dw-axis { display: grid; grid-template-columns: 1fr auto 1fr; font-family: var(--mono); font-size: .72rem; color: var(--dim); margin: 0 0 6px 170px; }
  .dw-axis span:nth-child(2) { color: var(--sun); }
  .dw-axis span:last-child { text-align: right; }
  .dw-row { display: grid; grid-template-columns: 160px 1fr 92px; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line-soft); cursor: pointer; transition: background .2s; border-radius: 10px; }
  .dw-row:hover { background: #ffffff06; }
  .dw-row.selected { background: #ffb02012; }
  .dw-name { font-family: var(--display); font-weight: 700; font-size: 1.05rem; display: flex; align-items: center; gap: 8px; }
  .dw-name .zi { color: var(--c); }
  .dw-track { position: relative; height: 28px; }
  .dw-track::before { content: ''; position: absolute; left: 50%; top: -6px; bottom: -6px; width: 2px; background: var(--sun); opacity: .7; }
  .dw-bar { position: absolute; top: 4px; height: 20px; background: var(--c); transition: width 1.2s var(--ease-out), left 1.2s var(--ease-out); width: 0; left: 50%; }
  .dw-bar.neg { border-radius: 6px 0 0 6px; }
  .dw-bar.pos { border-radius: 0 6px 6px 0; }
  .dw-val { text-align: right; font-family: var(--mono); font-weight: 600; font-size: .95rem; }
  .dw-val small { display: block; color: var(--dim); font-size: .72rem; font-weight: 400; }
  .dw-side { display: grid; gap: 18px; }
  .rest-list { display: grid; gap: 8px; margin-top: 14px; }
  .rest-item { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border-radius: 12px; background: repeating-linear-gradient(135deg, var(--surface-2) 0 8px, #241f44 8px 14px); cursor: pointer; border: 1px solid transparent; transition: border-color .2s; }
  .rest-item:hover { border-color: var(--line); }
  .rest-item b { font-family: var(--display); }
  .rest-item span { color: var(--dim); font-size: .85rem; }
  .dw-explain p { color: var(--muted); font-size: .95rem; }
  .dw-explain p:last-child { margin: 0; }
  @media (max-width: 980px) { .dw-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .dw-row { grid-template-columns: 1fr 70px; }
    .dw-track { grid-column: 1 / -1; grid-row: 2; }
    .dw-axis { margin-left: 0; }
  }
</style>

<script>
  import { bridge, type Pulse, type StatusLite } from '../lib/bridge';
  import { store } from '../lib/store';
  import { reveal } from '../lib/motion';
  import { MONTHS, esc, icon, statusColor, STATUS_ICON } from '../lib/format';

  const root = document.querySelector<HTMLElement>('#dry')!;
  const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
  let win: 'd30' | 'd60' | 'd90' = 'd60';
  let data: Pulse | null = null;

  new IntersectionObserver(([e], o) => {
    if (e.isIntersecting) {
      root.classList.add('cracked');
      o.disconnect();
    }
  }, { threshold: 0.2 }).observe(root);

  function render() {
    if (!data) return;
    const active = data.regions.filter((r) => r.status !== 'seasonal-dry' && r.windows);
    const resting = data.regions.filter((r) => r.status === 'seasonal-dry');
    active.sort((a, b) => (a.windows[win].pct ?? 999) - (b.windows[win].pct ?? 999));
    const rows = $('[data-rows]');
    root.querySelector('.card-title')!.textContent = `Rain over the last ${win.slice(1)} days, % of normal`;
    rows.innerHTML = active.map((r: StatusLite) => {
      const w = r.windows[win];
      const pct = w.pct ?? 100;
      const c = statusColor(r.status, pct);
      const delta = Math.max(-100, Math.min(100, pct - 100));
      const width = Math.abs(delta) / 2;
      const left = delta < 0 ? 50 - width : 50;
      const tip = `<b>${esc(r.name)}</b><br>${esc(r.label)}<div class="t-row"><span>Rain</span><span>${w.rain.toFixed(0)} mm</span></div><div class="t-row"><span>Normal</span><span>${w.normal.toFixed(0)} mm</span></div><div class="t-row"><span>Dry spell now</span><span>${r.drySpellDays} days</span></div><div class="t-row"><span>Soil wetness</span><span>${r.soil.wetness ?? '—'} (normal ${r.soil.normal ?? '—'})</span></div>`;
      return `<div class="dw-row ${r.id === store.region ? 'selected' : ''}" role="listitem" tabindex="0" style="--c:${c}" data-region="${r.id}" data-tip="${esc(tip)}">
        <span class="dw-name">${icon(STATUS_ICON[r.status] ?? 'eye')}${esc(r.name)}</span>
        <span class="dw-track"><span class="dw-bar ${delta < 0 ? 'neg' : 'pos'}" data-l="${left}" data-w="${width}"></span></span>
        <span class="dw-val">${w.pct === null ? '—' : `${w.pct.toFixed(0)}%`}<small>${w.rain.toFixed(0)} / ${w.normal.toFixed(0)} mm</small></span>
      </div>`;
    }).join('') || '<p class="card-sub">Every region is in its dry season right now.</p>';
    requestAnimationFrame(() => rows.querySelectorAll<HTMLElement>('.dw-bar').forEach((b) => {
      b.style.left = `${b.dataset.l}%`;
      b.style.width = `${b.dataset.w}%`;
    }));
    rows.querySelectorAll<HTMLElement>('[data-region]').forEach((row) => {
      const go = () => {
        store.select(row.dataset.region!);
        document.querySelector('#region')?.scrollIntoView({ behavior: 'smooth' });
      };
      row.addEventListener('click', go);
      row.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && (e.preventDefault(), go()));
    });
    $('[data-rest]').innerHTML = resting.length
      ? resting.map((r) => `<div class="rest-item" data-region="${r.id}"><b>${esc(r.name)}</b><span>${r.season.nextRainyMonth ? `rains return ~${MONTHS[r.season.nextRainyMonth - 1]}` : ''}</span></div>`).join('')
      : '<p class="card-sub" style="margin-top:10px">No region is in a fully dry season right now, so every one is ranked on the left.</p>';
    $('[data-rest]').querySelectorAll<HTMLElement>('[data-region]').forEach((el) => el.addEventListener('click', () => store.select(el.dataset.region!)));
    $('[data-table]').innerHTML = `<table class="data-table"><thead><tr><th>Region</th><th>Status</th><th>Rain (mm)</th><th>Normal (mm)</th><th>% of normal</th><th>Dry spell (days)</th></tr></thead><tbody>${data.regions.map((r) => `<tr><td>${esc(r.name)}</td><td>${esc(r.label)}</td><td class="num">${r.windows?.[win].rain.toFixed(0) ?? '—'}</td><td class="num">${r.windows?.[win].normal.toFixed(0) ?? '—'}</td><td class="num">${r.windows?.[win].pct?.toFixed(0) ?? '—'}</td><td class="num">${r.drySpellDays ?? '—'}</td></tr>`).join('')}</tbody></table>`;
    reveal(root);
  }

  root.querySelectorAll<HTMLButtonElement>('[data-win]').forEach((b) => b.addEventListener('click', () => {
    win = b.dataset.win as typeof win;
    root.querySelectorAll('[data-win]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    render();
  }));

  bridge.pulse().then((p) => {
    data = p;
    render();
  }).catch((err) => {
    $('[data-rows]').innerHTML = `<div class="error-box">${icon('info')}<div>${esc(err.message)}</div></div>`;
  });

  store.subscribe((id) => root.querySelectorAll<HTMLElement>('.dw-row').forEach((r) => r.classList.toggle('selected', r.dataset.region === id)));
</script>
