---
const links = [
  { href: '#pulse', label: 'Pulse', icon: 'drop' },
  { href: '#map', label: 'Rain map', icon: 'map' },
  { href: '#dry', label: 'Dry watch', icon: 'crack' },
  { href: '#region', label: 'Why?', icon: 'search' },
  { href: '#radar', label: 'Radar', icon: 'radar' },
  { href: '#model', label: 'Forecast AI', icon: 'spark' },
  { href: '#history', label: 'History', icon: 'calendar' },
];
---
<header class="nav" data-nav>
  <a class="nav-brand" href="#top" aria-label="Zinab Lab, back to top">
    <svg viewBox="0 0 64 64" class="nav-logo" aria-hidden="true"><path d="M6 50 22 28l8 11 6-8 22 19Z" fill="#ffb020" /><path class="logo-drop" d="M38 6s-10 11-10 18a10 10 0 0 0 20 0c0-7-10-18-10-18Z" fill="#4cc3ff" /></svg>
    <span class="nav-word">Zinab<b>Lab</b></span>
  </a>
  <nav aria-label="Sections">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} data-nav-link><svg class="zi"><use href={`#i-${l.icon}`} /></svg><span>{l.label}</span></a></li>
      ))}
    </ul>
  </nav>
  <button class="nav-ask" type="button" data-open-gelada aria-label="Ask Gelada, the rain assistant"><svg class="zi"><use href="#i-ask" /></svg><span>Ask</span></button>
</header>

<style is:global>
  .nav { position: fixed; top: max(14px, env(safe-area-inset-top, 0px)); left: 50%; z-index: 900; transform: translateX(-50%); width: min(1180px, calc(100% - 24px)); display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 16px; border-radius: 999px; background: #0c0a1cb8; border: 1px solid #ffffff1c; backdrop-filter: blur(16px) saturate(1.4); box-shadow: 0 20px 50px #00000055; transition: transform .5s var(--ease-out), background .3s; }
  .nav.hide { transform: translate(-50%, -140%); }
  .nav-brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); flex: none; }
  .nav-logo { width: 34px; height: 34px; }
  .logo-drop { animation: bob 3.2s ease-in-out infinite; transform-origin: center; }
  @keyframes bob { 50% { transform: translateY(3px); } }
  .nav-word { font-family: var(--display); font-weight: 800; font-size: 1.2rem; letter-spacing: -.03em; }
  .nav-word b { color: var(--sun); font-weight: 800; }
  .nav nav { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; mask-image: linear-gradient(90deg, transparent, #000 12px, #000 calc(100% - 12px), transparent); }
  .nav nav::-webkit-scrollbar { display: none; }
  .nav ul { display: flex; justify-content: center; gap: 2px; margin: 0; padding: 0 8px; list-style: none; width: max-content; min-width: 100%; }
  .nav nav a { display: flex; align-items: center; gap: 7px; padding: 9px 13px; border-radius: 999px; color: var(--muted); text-decoration: none; font-size: .92rem; font-weight: 700; white-space: nowrap; transition: color .2s, background .2s; }
  .nav nav a .zi { width: 1.05em; height: 1.05em; opacity: .7; }
  .nav nav a:hover { color: var(--ink); background: #ffffff0d; }
  .nav nav a.active { color: var(--night); background: var(--bone); }
  .nav nav a.active .zi { opacity: 1; color: var(--ember); }
  .nav-ask { flex: none; display: flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px; border: 0; background: var(--sun); color: var(--night); font-family: var(--display); font-weight: 800; cursor: pointer; transition: transform .3s var(--ease-spring); }
  .nav-ask:hover { transform: scale(1.06) rotate(-2deg); }
  @media (max-width: 860px) {
    .nav-word { display: none; }
    .nav nav a span { display: none; }
    .nav nav a { padding: 10px; }
    .nav nav a .zi { width: 1.25em; height: 1.25em; }
    .nav ul { justify-content: flex-start; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  let lastY = window.scrollY;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    nav.classList.toggle('hide', y > lastY && y > 400);
    lastY = y;
  }, { passive: true });
  const sections = links.map((a) => document.querySelector(a.getAttribute('href')!)).filter(Boolean) as Element[];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        links.forEach((a) => a.classList.toggle('active', a.getAttribute('href') === `#${e.target.id}`));
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  sections.forEach((s) => io.observe(s));
</script>
