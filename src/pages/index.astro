---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Pulse from '../components/Pulse.astro';
import RainMap from '../components/RainMap.astro';
import DryWatch from '../components/DryWatch.astro';
import RegionDeepDive from '../components/RegionDeepDive.astro';
import Radar from '../components/Radar.astro';
import ModelCard from '../components/ModelCard.astro';
import History from '../components/History.astro';
import Footer from '../components/Footer.astro';
import Gelada from '../components/Gelada.astro';
---
<Layout>
  <Nav />
  <main>
    <Hero />
    <Pulse />
    <RainMap />
    <DryWatch />
    <RegionDeepDive />
    <Radar />
    <ModelCard />
    <History />
  </main>
  <Footer />
  <Gelada />
</Layout>

<script>
  import { initTooltips, reveal } from '../lib/motion';

  initTooltips();
  reveal();
</script>
