---
export const prerender = true;

import DashboardShell from '../components/DashboardShell.astro';
import { historyYears, locations } from '../data/locations';
---
<DashboardShell activePage="overview" breadcrumb="Climate overview" title="Zinab Lab | Ethiopia Climate Explorer" description="Explore NASA POWER precipitation data, interactive location profiles, and transparent rainfall trend analytics across Ethiopia.">
  <div id="overview">
        <section class="intro">
          <div>
            <p class="eyebrow"><span class="eyebrow-line"></span> ETHIOPIA · EARTH OBSERVATION</p>
            <h1>Climate, in<br /><span>clearer focus.</span></h1>
            <p class="intro-copy">Explore precipitation patterns across Ethiopia. Satellite-era climate data, translated into insights for local resilience.</p>
          </div>
          <div class="data-stamp"><span class="stamp-icon">◎</span><span><b>POWER</b><small>NASA Earth data</small></span><i class="live-dot"></i></div>
        </section>

        <section class="control-row" aria-label="Dashboard filters">
          <label class="select-control"><span>REGION</span><select id="region-select" aria-label="Select a region">
            {locations.map((location) => <option value={location.id}>{location.name}</option>)}
          </select></label>
          <label class="select-control year-control"><span>YEAR</span><select id="year-select" aria-label="Select a year">
            {historyYears.map((year) => <option value={year} selected={year === historyYears[historyYears.length - 1]}>{year}</option>)}
          </select></label>
          <button type="button" class="refresh-button" id="refresh-button"><span class="refresh-icon">↻</span> Refresh data</button>
          <span class="fetch-status" id="fetch-status" role="status" aria-live="polite">Connecting to live climate data…</span>
        </section>

        <section class="metric-grid" aria-label="Selected region climate summary">
          <article class="metric-card"><div class="metric-top"><span>ANNUAL DAILY MEAN</span><span class="metric-icon blue">⌁</span></div><div class="metric-value"><strong id="annual-total">—</strong><span>mm / day</span></div><p class="metric-foot">Average daily precipitation across the year</p></article>
          <article class="metric-card"><div class="metric-top"><span>WETTEST MONTH</span><span class="metric-icon aqua">↗</span></div><div class="metric-value"><strong id="wettest-month">—</strong></div><p class="metric-foot" id="wettest-detail">Monthly precipitation rate</p></article>
          <article class="metric-card"><div class="metric-top"><span>SELECTED LOCATION</span><span class="metric-icon gold">⌖</span></div><div class="metric-value location-value"><strong id="location-name">Addis Ababa</strong></div><p class="metric-foot" id="location-coords">9.03° N, 38.74° E</p></article>
        </section>

        <section class="data-grid" id="rainfall">
          <article class="panel chart-panel">
            <div class="panel-heading"><div><p class="panel-kicker">PRECIPITATION PROFILE</p><h2>Rainfall through the year</h2></div><span class="unit-tag">mm / day</span></div>
            <p class="panel-description">NASA POWER monthly mean precipitation · <span id="chart-region">Central Highlands</span> · <span id="chart-year">{historyYears[historyYears.length - 1]}</span></p>
            <div class="chart-wrap"><div class="y-labels" aria-hidden="true"><span id="scale-top">6</span><span id="scale-mid">3</span><span>0</span></div><div class="chart-area"><div class="grid-lines" aria-hidden="true"><i></i><i></i><i></i></div><div class="bar-chart" id="bar-chart" role="img" aria-label="Monthly precipitation chart"><span class="chart-empty">Load data to explore rainfall</span></div><div class="month-labels" aria-hidden="true"><span>JAN</span><span>FEB</span><span>MAR</span><span>APR</span><span>MAY</span><span>JUN</span><span>JUL</span><span>AUG</span><span>SEP</span><span>OCT</span><span>NOV</span><span>DEC</span></div></div></div>
            <p class="chart-note"><span class="legend-dot"></span>Monthly mean precipitation rate <span class="note-separator">·</span> NASA POWER via Zinab API <span id="data-note">Connecting…</span></p>
          </article>

          <article class="panel map-panel">
            <div class="panel-heading"><div><p class="panel-kicker">REGIONAL EXPLORER</p><h2>Observation point</h2></div><span class="map-target">ETHIOPIA</span></div>
            <div class="map-visual">
              <iframe
                id="map-frame"
                title="Interactive OpenStreetMap of Ethiopia showing the selected observation point"
                src="https://www.openstreetmap.org/export/embed.html?bbox=32.9%2C3.3%2C48.1%2C15.2&amp;layer=mapnik&amp;marker=9.03%2C38.74"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
              <div class="map-caption"><span class="live-dot"></span><span id="map-region-label">Central Highlands</span><span class="caption-coordinate" id="map-coordinate">9.03°N · 38.74°E</span></div>
            </div>
            <p class="map-footnote">Select a region to move the observation marker. Map tiles © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>.</p>
          </article>
        </section>

        <section class="panel forecast-panel" aria-labelledby="forecast-heading">
          <div class="panel-heading">
            <div><p class="panel-kicker">EXPERIMENTAL ML MODEL</p><h2 id="forecast-heading">Machine-learning rainfall outlook</h2></div>
            <a class="text-link" href="/analytics/">View map + all projections <span aria-hidden="true">↗</span></a>
          </div>
          <p class="panel-description">A TensorFlow.js model trained with gradient descent on five complete years of NASA POWER data for <span id="forecast-location">Central Highlands</span>. Experimental climate analysis, not a weather forecast.</p>
          <p id="forecast-status" class="forecast-status" role="status" aria-live="polite">Loading observed history for the selected point…</p>
          <div class="forecast-summary">
            <article class="metric-card"><div class="metric-top"><span>PROJECTED DAILY MEAN · <span id="forecast-year">—</span></span></div><div class="metric-value"><strong id="projected-mean">—</strong><span>mm / day</span></div></article>
            <article class="metric-card"><div class="metric-top"><span>VS. RECENT BASELINE</span></div><div class="metric-value"><strong id="forecast-change">—</strong><span id="forecast-direction">awaiting data</span></div></article>
          </div>
          <div id="forecast-chart" class="forecast-chart" role="img" aria-label="Monthly trend projection chart"></div>
          <p class="chart-note"><span class="legend-dot"></span>Experimental monthly model projection · Not a weather forecast · <span id="forecast-years">Awaiting complete observations</span></p>
        </section>

        <section class="panel seasons-panel" id="seasons">
          <div class="panel-heading season-heading"><div><p class="panel-kicker">LOCAL CONTEXT</p><h2>Ethiopia’s rainfall seasons</h2></div><p class="season-intro">Season names describe broad patterns; timing and intensity vary by region and year.</p></div>
          <div class="season-cards"><article class="season-card"><span class="season-number">01</span><div><h3>Belg</h3><p>February – May</p><small>Short rains · important in southern and eastern areas</small></div><span class="season-symbol">◌</span></article><article class="season-card"><span class="season-number">02</span><div><h3>Kiremt</h3><p>June – September</p><small>Main rains · supports much of the highland growing season</small></div><span class="season-symbol">⌁</span></article><article class="season-card"><span class="season-number">03</span><div><h3>Bega</h3><p>October – January</p><small>Generally drier season · local conditions differ</small></div><span class="season-symbol">☼</span></article></div>
        </section>

        <footer class="app-footer"><span><b>ZINAB LAB</b> · NASA Space Apps Challenge</span><span>Data: <a href="https://power.larc.nasa.gov/" target="_blank" rel="noreferrer">NASA POWER</a> · Estimates are not forecasts</span></footer>
      </div>

  <script>
    import { fetchMonthlyHistory, fetchRainfallAnalytics, type MonthlyHistory } from '../lib/climate-analytics';
    import type { RainfallAnalytics } from '../data/analytics-types';
    import { historyYears, locations } from '../data/locations';

    const regionSelect = document.querySelector('#region-select');
    const yearSelect = document.querySelector('#year-select');
    const refreshButton = document.querySelector('#refresh-button');
    const status = document.querySelector('#fetch-status');
    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const historyCache = new Map<string, MonthlyHistory>();
    let activeRequest = 0;
    let mappedRegion = 'addis';
    let cachedAnalytics: RainfallAnalytics | undefined;
    let analyticsRequest: Promise<RainfallAnalytics> | undefined;
    const $ = (selector) => document.querySelector(selector);

    function loadRainfallAnalytics() {
      if (cachedAnalytics) return Promise.resolve(cachedAnalytics);
      if (!analyticsRequest) {
        analyticsRequest = fetchRainfallAnalytics(historyYears[0], historyYears[historyYears.length - 1])
          .then((result) => {
            cachedAnalytics = result;
            return result;
          })
          .finally(() => {
            analyticsRequest = undefined;
          });
      }
      return analyticsRequest;
    }

    function updateSummary(values, region, year) {
      const total = values.reduce((sum, value) => sum + value, 0);
      const wettestIndex = values.indexOf(Math.max(...values));
      $('#annual-total').textContent = (total / 12).toFixed(2);
      $('#wettest-month').textContent = monthNames[wettestIndex];
      $('#wettest-detail').textContent = `${values[wettestIndex].toFixed(2)} mm/day · ${year}`;
      $('#chart-region').textContent = region.name;
      $('#chart-year').textContent = year;
      $('#data-note').textContent = 'Connected · live backend data';
      $('#bar-chart').setAttribute('aria-label', `NASA POWER monthly precipitation rate for ${region.name} in ${year}`);
      const max = Math.max(1, ...values);
      $('#scale-top').textContent = max.toFixed(1);
      $('#scale-mid').textContent = (max / 2).toFixed(1);
      $('#bar-chart').innerHTML = values.map((value, index) => `<span class="bar${index === wettestIndex ? ' peak' : ''}" style="--bar-height:${Math.max(4, (value / max) * 100)}%" title="${monthNames[index]}: ${value.toFixed(2)} mm/day"><i>${value.toFixed(1)}</i></span>`).join('');
    }

    function clearSummary(message) {
      $('#annual-total').textContent = '—';
      $('#wettest-month').textContent = '—';
      $('#wettest-detail').textContent = message;
      $('#chart-year').textContent = yearSelect.value;
      $('#scale-top').textContent = '—';
      $('#scale-mid').textContent = '—';
      $('#data-note').textContent = 'Live data unavailable';
      const empty = document.createElement('span');
      empty.className = 'chart-empty';
      empty.textContent = message;
      $('#bar-chart').replaceChildren(empty);
      $('#bar-chart').setAttribute('aria-label', message);
    }

    function updateForecast(projection, model, region) {
      $('#forecast-location').textContent = region.name;
      $('#forecast-year').textContent = model.targetYear;
      $('#projected-mean').textContent = projection.projectedMean.toFixed(2);
      $('#forecast-change').textContent = `${projection.changePercent >= 0 ? '+' : ''}${projection.changePercent.toFixed(1)}%`;
      $('#forecast-direction').textContent = 'vs. recent mean';
      $('#forecast-years').textContent = `${model.historyStart}–${model.historyEnd} observed`;
      $('#forecast-status').textContent = `TensorFlow.js gradient model · ${model.sampleCount} observations · training RMSE ${model.trainingRmse.toFixed(2)} mm/day.`;
      const max = Math.max(1, ...projection.monthlyValues);
      $('#forecast-chart').setAttribute('aria-label', `Machine-learning projection for monthly precipitation in ${model.targetYear} at ${region.label}`);
      $('#forecast-chart').innerHTML = projection.monthlyValues.map((value, index) =>
        `<span class="forecast-bar" style="--bar-height:${Math.max(3, (value / max) * 100)}%" title="${monthNames[index]} projected: ${value.toFixed(2)} mm/day"><i>${monthNames[index]}</i></span>`,
      ).join('');
    }

    function clearForecast(message) {
      $('#forecast-status').textContent = message;
      $('#forecast-year').textContent = '—';
      $('#projected-mean').textContent = '—';
      $('#forecast-change').textContent = '—';
      $('#forecast-direction').textContent = 'unavailable';
      $('#forecast-years').textContent = 'No complete observed history';
      $('#forecast-chart').innerHTML = '';
    }

    async function loadData() {
      const requestId = ++activeRequest;
      const region = locations.find((location) => location.id === regionSelect.value);
      if (!region) throw new Error('Select a valid observation point.');
      const year = Number(yearSelect.value);
      refreshButton.disabled = true;
      refreshButton.classList.add('loading');
      status.textContent = 'Requesting live data from the dashboard API…';
      status.classList.remove('error');
      $('#location-name').textContent = region.label;
      $('#location-coords').textContent = `${region.lat.toFixed(2)}° N, ${region.lon.toFixed(2)}° E`;
      $('#map-region-label').textContent = region.name;
      $('#map-coordinate').textContent = `${region.lat.toFixed(2)}°N · ${region.lon.toFixed(2)}°E`;
      clearSummary('Waiting for live data…');
      clearForecast('Waiting for complete live history…');
      if (mappedRegion !== region.id) {
        const mapParams = new URLSearchParams({
          bbox: '32.9,3.3,48.1,15.2',
          layer: 'mapnik',
          marker: `${region.lat},${region.lon}`,
        });
        $('#map-frame').src = `https://www.openstreetmap.org/export/embed.html?${mapParams}`;
        mappedRegion = region.id;
      }
      try {
        const cachedHistory = historyCache.get(region.id);
        const historyRequest = cachedHistory
          ? Promise.resolve(cachedHistory)
          : fetchMonthlyHistory(region, historyYears[0], historyYears[historyYears.length - 1])
            .then((history) => {
              historyCache.set(region.id, history);
              return history;
            });
        const [historyResult, analyticsResult] = await Promise.allSettled([
          historyRequest,
          loadRainfallAnalytics(),
        ]);
        if (requestId !== activeRequest) return;

        if (historyResult.status === 'fulfilled') {
          const values = historyResult.value[year];
          if (values) {
            updateSummary(values, region, year);
            status.textContent = 'Connected · NASA POWER data served by Zinab API';
          } else {
            clearSummary(`The backend has no complete observations for ${year}.`);
            status.textContent = `No complete backend observations for ${year}.`;
            status.classList.add('error');
          }
        } else {
          const message = historyResult.reason instanceof Error ? historyResult.reason.message : 'Unexpected API error.';
          clearSummary('No live observations available');
          status.textContent = `Backend data unavailable · ${message}`;
          status.classList.add('error');
        }

        if (analyticsResult.status === 'fulfilled') {
          const projection = analyticsResult.value.locations.find((point) => point.id === region.id);
          if (projection) updateForecast(projection, analyticsResult.value.model, region);
          else clearForecast('The model API did not return this observation point.');
        } else {
          const message = analyticsResult.reason instanceof Error ? analyticsResult.reason.message : 'Unexpected model API error.';
          clearForecast(`Machine-learning projection unavailable: ${message}`);
        }
      } catch (error) {
        const message = error instanceof Error ? error.message : 'Unexpected dashboard error.';
        clearSummary(message);
        status.textContent = message;
        status.classList.add('error');
        clearForecast(message);
      } finally {
        if (requestId === activeRequest) {
          refreshButton.disabled = false;
          refreshButton.classList.remove('loading');
        }
      }
    }

    regionSelect.addEventListener('change', loadData);
    yearSelect.addEventListener('change', loadData);
    refreshButton.addEventListener('click', loadData);
    loadData();
  </script>
</DashboardShell>

<style>
  .app-shell{min-height:100vh;display:grid;grid-template-columns:244px minmax(0,1fr);background:#0b1417;color:#e8f0ed;font-family:var(--display)}
  .sidebar{position:sticky;top:0;height:100vh;padding:28px 18px 20px;background:#0d171a;border-right:1px solid #1e2b2c;display:flex;flex-direction:column;z-index:2}
  .brand{display:flex;align-items:center;gap:11px;color:#e6f4ee;text-decoration:none;font-size:15px;letter-spacing:.13em;font-weight:700;padding:0 10px 42px}
  .brand-mark{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:#94edc1;color:#0b1915;font-size:19px;letter-spacing:0}
  .brand-light{font-weight:400;color:#93aaa2}
  .side-label{padding:0 10px;color:#647a72;font-size:10px;letter-spacing:.18em;font-weight:700;margin-bottom:12px}
  .side-link{display:flex;align-items:center;gap:12px;padding:12px 11px;margin:2px 0;border-radius:8px;color:#91a49d;text-decoration:none;font-size:13px;transition:background .18s,color .18s}
  .side-link:hover,.side-link.active{background:#192723;color:#c7f5d9}.side-link.active{box-shadow:inset 2px 0 #91efbd}.side-icon{font-size:19px;width:18px;text-align:center;color:#78b897}
  .sidebar-bottom{margin-top:auto;border-top:1px solid #24312e;padding:16px 8px 0;display:flex;align-items:center;gap:9px;color:#93a69e;font-size:11px}.sidebar-bottom a{margin-left:auto;color:#8da39a;text-decoration:none;font-size:16px}
  .live-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#74e9ad;box-shadow:0 0 10px #62d99b88;flex:none}
  .main-column{min-width:0}.topbar{height:64px;border-bottom:1px solid #1e2b2c;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(22px,4vw,58px);background:#0d171a}.breadcrumbs{font-size:12px;color:#81958d}.breadcrumbs span{padding:0 10px;color:#40534b}.breadcrumbs strong{color:#d9e7e1;font-weight:500}.challenge-pill{display:flex;gap:9px;align-items:center;border:1px solid #32453b;border-radius:20px;padding:7px 12px;color:#b8d5c6;text-decoration:none;font-size:9px;letter-spacing:.09em}.challenge-pill>span:first-child{color:#a6eec1;font-size:13px}.external{font-size:12px}
  .content{width:min(1350px,100%);margin:0 auto;padding:32px clamp(22px,4vw,58px) 20px}.intro{display:flex;align-items:flex-end;justify-content:space-between;padding:14px 0 25px}.eyebrow,.panel-kicker{color:#89b59c;font-size:9px;font-weight:700;letter-spacing:.16em;margin:0 0 12px}.eyebrow-line{display:inline-block;width:22px;border-top:1px solid #8ce2b2;vertical-align:middle;margin-right:8px}.intro h1{font-size:clamp(38px,5vw,62px);letter-spacing:-.055em;line-height:.98;font-weight:500;margin:0 0 14px}.intro h1 span{color:#9aefbd}.intro-copy{max-width:530px;font-family:var(--body);font-size:14px;line-height:1.75;color:#9daea7;margin:0}.data-stamp{display:flex;align-items:center;gap:10px;border:1px solid #263630;border-radius:9px;padding:10px 13px;margin-bottom:4px}.stamp-icon{font-size:22px;color:#92e9b5}.data-stamp b,.data-stamp small{display:block}.data-stamp b{font-size:10px;letter-spacing:.1em;color:#d9e8e0}.data-stamp small{font-size:9px;color:#7f958a;margin-top:3px}.data-stamp .live-dot{margin-left:7px}
  .control-row{display:flex;align-items:center;gap:10px;padding:14px 16px;margin-bottom:14px;border:1px solid #25332e;border-radius:10px;background:#111d1b}.select-control{display:flex;align-items:center;gap:10px;padding:0 11px;border:1px solid #2c3b35;border-radius:7px;background:#0e1816;height:37px}.select-control>span{font-size:9px;letter-spacing:.1em;color:#81968c;font-weight:700}.select-control select{appearance:none;min-width:145px;border:0;background:transparent;color:#dce9e2;font:500 11px var(--display);outline:none;cursor:pointer}.select-control select option{background:#13201c}.year-control select{min-width:56px}.refresh-button{display:flex;align-items:center;gap:8px;height:37px;padding:0 13px;border:1px solid #355343;border-radius:7px;background:#183126;color:#b5edca;font:500 11px var(--display);cursor:pointer;transition:background .2s}.refresh-button:hover{background:#224432}.refresh-button:disabled{opacity:.7;cursor:wait}.refresh-icon{font-size:17px}.loading .refresh-icon{animation:spin 1s linear infinite}.fetch-status{margin-left:auto;color:#89ac99;font-size:10px}.fetch-status.error{color:#e8bd7c}@keyframes spin{to{transform:rotate(360deg)}}
  .metric-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-bottom:14px}.metric-card,.panel{border:1px solid #25332e;border-radius:10px;background:#111b19}.metric-card{padding:15px 17px 13px;min-height:112px}.metric-top{display:flex;align-items:center;justify-content:space-between;color:#80958b;font-size:9px;letter-spacing:.1em;font-weight:700}.metric-icon{width:24px;height:24px;border-radius:7px;display:grid;place-items:center;font-size:17px}.metric-icon.blue{color:#94c8ed;background:#1a2e36}.metric-icon.aqua{color:#8ce5c0;background:#1a3229}.metric-icon.gold{color:#e4c381;background:#322c20}.metric-value{display:flex;align-items:baseline;gap:8px;margin-top:8px}.metric-value strong{font-size:25px;line-height:1.1;font-weight:500;letter-spacing:-.035em;color:#edf5ef}.metric-value>span{font-size:10px;color:#8ca096}.metric-value.location-value strong{font-size:20px}.metric-foot{font-size:10px;color:#82948a;margin:5px 0 0}
