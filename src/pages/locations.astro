---
export const prerender = true;

import DashboardShell from '../components/DashboardShell.astro';
import { locations } from '../data/locations';

const mapUrl = (location: (typeof locations)[number]) => {
  const bbox = [
    location.lon - 1.4,
    location.lat - 1.1,
    location.lon + 1.4,
    location.lat + 1.1,
  ].join(',');
  const params = new URLSearchParams({
    bbox,
    layer: 'mapnik',
    marker: `${location.lat},${location.lon}`,
  });
  return `https://www.openstreetmap.org/export/embed.html?${params}`;
};
---

<DashboardShell activePage="locations" breadcrumb="Observation points" title="Observation points | Zinab Lab" description="Browse all four NASA POWER observation points in the Zinab Lab Ethiopia climate explorer.">
  <section class="page-intro">
    <p class="eyebrow"><span class="eyebrow-line"></span> ETHIOPIA · STATION DIRECTORY</p>
    <h1>Observation points</h1>
    <p class="intro-copy">Explore every sampled location, its coordinates, and its regional context. Select a point to see its precipitation history on an interactive map.</p>
  </section>

  <section class="location-grid" aria-label="All observation points">
    {locations.map((location) => (
      <article class="panel location-card">
        <div class="location-heading">
          <div><p class="panel-kicker">{location.name}</p><h2>{location.label}</h2></div>
          <span class="point-id">{location.id.toUpperCase()}</span>
        </div>
        <p class="location-description">{location.description}</p>
        <div class="map-visual directory-map">
          <iframe
            src={mapUrl(location)}
            title={`OpenStreetMap centered on ${location.label}, Ethiopia`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <div class="location-meta">
          <span><b>LAT</b> {location.lat.toFixed(2)}° N</span>
          <span><b>LON</b> {location.lon.toFixed(2)}° E</span>
        </div>
        <a class="location-link" href={`/locations/${location.id}/`}>Explore location data <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </section>
  <p class="map-footnote">Map tiles © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>. Climate estimates are point-based and do not represent every locality in a region.</p>
</DashboardShell>

<style>
  .page-intro{padding:14px 0 25px}.page-intro h1{font-size:clamp(34px,4vw,48px);letter-spacing:-.05em;font-weight:500;margin:0 0 12px}.page-intro .eyebrow{color:#89b59c;font-size:9px;font-weight:700;letter-spacing:.16em;margin:0 0 12px}.eyebrow-line{display:inline-block;width:22px;border-top:1px solid #8ce2b2;vertical-align:middle;margin-right:8px}.intro-copy{max-width:620px;font-family:var(--body);font-size:13px;line-height:1.75;color:#9daea7;margin:0}
  .location-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.location-card{padding:17px}.location-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.panel-kicker{color:#89b59c;font-size:8px;font-weight:700;letter-spacing:.16em;margin:0 0 7px}.location-heading h2{font-size:18px;font-weight:500;letter-spacing:-.03em}.point-id{border:1px solid #32483a;border-radius:5px;padding:4px 7px;color:#a8c9b4;font-size:8px;letter-spacing:.08em}.location-description{min-height:36px;margin:9px 0 12px;color:#869a90;font-size:10px}.directory-map{height:190px;margin:0}.location-meta{display:flex;gap:18px;margin:12px 0;color:#a3b6aa;font-size:10px;font-variant-numeric:tabular-nums}.location-meta b{color:#70857a;font-size:8px;letter-spacing:.1em;margin-right:4px}.location-link{display:inline-flex;gap:8px;align-items:center;color:#a0cfb0;text-decoration:none;font-size:10px;font-weight:600}.location-link:hover{text-decoration:underline}.map-footnote{font-size:9px;line-height:1.6;color:#788d82;margin:14px 0 0;font-family:var(--body)}.map-footnote a{color:#a0cfb0;text-decoration:none}.map-footnote a:hover{text-decoration:underline}
  @media(max-width:700px){.location-grid{grid-template-columns:1fr}.directory-map{height:210px}.location-card{padding:15px}}
</style>
